# Copy to .env in StudyWithMe and run Gradle from that directory.
# Supabase Dashboard > Connect > Session pooler (port 5432).
# Copy the exact host and username shown in the dashboard.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=

# Required separately for AI assignment generation.
GEMINI_API_KEY=
